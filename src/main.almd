import self as wx
import json
import value
effect fn main() -> Unit = {
  println(json.stringify(value.object([
    ("c0", value.string(wx.label(0))),
    ("c63", value.string(wx.label(63))),
    ("c95", value.string(wx.label(95))),
    ("unknown", value.string(wx.label(7))),
    ("q1", value.bool(wx.is_weather_query("東京の天気は？"))),
    ("q2", value.bool(wx.is_weather_query("こんにちは"))),
  ])))
}
