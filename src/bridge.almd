// wasm — Node の weather-tool から呼ぶ。
//   is_weather_query: text(buffer) → Bool(Float)
//   label: code(Int) → ラベル文字列を出力バッファに書き長さを返す → out_ptr で読む。
//          (label は呼ぶたびに 1 回だけ読む運用。to_string_lossy/from_string のエイリアス
//           対策で input/output は分離。)
import self as wx
import bytes
import float
import int
import list
import string

var g_in: Bytes = bytes.zeros(0)
var g_out: Bytes = bytes.zeros(0)

@export(wasm, "in_alloc")
fn in_alloc(len: Float) -> RawPtr = {
  g_in = bytes.zeros(int.from_saturating(len))
  bytes.as_mut_ptr(g_in)
}

// g_in を一旦 from_list(to_list(...)) で独立バッファにコピーしてから文字列化する。
// to_string_lossy は g_in をエイリアスし、終了時の String dec が g_in を free する
// (almide#690、released 未修正)。直接渡すと「同じ入力で 2 回以上呼ぶ / label を挟む」
// と g_in が解放済みになり trap する。コピー経由なら g_in は無傷で多重読みも安全。
@export(wasm, "is_weather_query")
fn is_weather_query() -> Float =
  if wx.is_weather_query(bytes.to_string_lossy(bytes.from_list(bytes.to_list(g_in)))) then 1.0 else 0.0

@export(wasm, "label_resolve")
fn label_resolve(code: Float) -> Float = {
  let s = wx.label(int.from_saturating(code))
  g_out = bytes.from_string(s)
  float.from(list.len(bytes.to_list(bytes.from_string(s))))
}

@export(wasm, "out_ptr")
fn out_ptr() -> RawPtr = bytes.as_mut_ptr(g_out)

@export(wasm, "is_known")
fn is_known(code: Float) -> Float = if wx.is_known(int.from_saturating(code)) then 1.0 else 0.0

effect fn main() -> Unit = {
  let _a = in_alloc(1.0)
  let _b = is_weather_query()
  let _c = label_resolve(0.0)
  let _d = out_ptr()
  let _e = is_known(0.0)
  ()
}
